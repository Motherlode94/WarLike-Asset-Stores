        },
        {
          "id": "grain",
          "type": "FilmGrain",
          "settings": {
            "strength": 0.08
          }
        },
        {
          "id": "out",
          "type": "Output"
        }
      ],
      "links": [
        [
          "source",
          "curves"
        ],
        [
          "curves",
