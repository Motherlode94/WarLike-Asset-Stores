{
  "schema": "warlike.node.presets.v1",
  "compatibility": "reference-only",
  "presets": [
    {
      "id": "green-screen",
      "name": "Fond vert",
      "nodes": [
        {
          "id": "source",
          "type": "VideoInput"
        },
        {
          "id": "key",
          "type": "ChromaKey",
          "settings": {
            "color": "#00ff00",
            "threshold": 0.2,
            "softness": 0.1
          }
        },
        {
          "id": "out",
          "type": "CompositeOutput"
        }
      ],
      "links": [
